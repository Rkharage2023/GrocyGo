PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=grocery_store
DB_USER=root
DB_PASSWORD=your_mysql_password

JWT_SECRET=YourAccessTokenSecretKey
JWT_REFRESH_SECRET=YourRefreshTokenSecretKey

CLOUDINARY_CLOUD_NAME=YourCloudinaryCloudName
CLOUDINARY_API_KEY=YourCloudinaryApiKey
CLOUDINARY_API_SECRET=YourCloudinaryApiSecret

node -e "console.log(require('bcrypt').hashSync('yourpassword', 10))" 

CLIENT_URL=your_client_url
DATABASE_URL=your_production_mysql_database_connection_url_optional

# OTP Configurations
OTP_EXPIRY_MINS=5
OTP_RESEND_COOLDOWN_SECS=60

# Rate Limiter Configurations
OTP_RATE_LIMIT_WINDOW_MS=300000 # 5 minutes in milliseconds
OTP_RATE_LIMIT_MAX=5

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=5